FROM node:22.23.4-alpine3.23 AS builder
RUN npm install --global npm@12.2.1

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

ARG API_URL

RUN printf "export const environment = {\n  production: true,\n  apiUrl: '%s'\n};\n" "$API_URL" > src/environments/environment.ts

RUN npm run build -- --configuration production

FROM node:22.23.4-alpine3.23

WORKDIR /app

COPY docker/http-server/package*.json /opt/http-server/
RUN npm ci --prefix /opt/http-server --omit=dev --ignore-scripts
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
ENV PATH="/opt/http-server/node_modules/.bin:$PATH"

COPY --from=builder /app/dist/demo/browser ./dist

EXPOSE 8081

CMD ["http-server", "./dist", "-p", "8081", "-c-1", "--proxy", "http://localhost:8081?"]
